# Maintainer: SakulFlee <sakulflee@users.noreply.github.com>
pkgname=fansly-recorder
pkgver=0.1.18
pkgrel=1
pkgdesc="Record Fansly live streams"
arch=('any')
url="https://github.com/SakulFlee/FanslyRecorder"
license=('MIT')
depends=(
  python
  python-playwright
  streamlink
  ffmpeg
)
makedepends=(
  python-build
  python-installer
  python-setuptools
)
install=fansly-recorder.install
source=("FanslyRecorder-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "FanslyRecorder-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "FanslyRecorder-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
