# Maintainer: SakulFlee <sakulflee@users.noreply.github.com>
pkgname=fansly-recorder
pkgver=0.1.24
pkgrel=1
pkgdesc="Record Fansly live streams"
arch=('any')
url="https://github.com/SakulFlee/FanslyRecorder"
license=('MIT')
depends=(
  python
  python-playwright
  chromium
  streamlink
  ffmpeg
)
makedepends=(
  python-build
  python-installer
  python-setuptools
)
install=fansly-recorder.install
source=("FanslyRecorder-$pkgver.tar.gz::https://github.com/SakulFlee/FanslyRecorder/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "FanslyRecorder-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "FanslyRecorder-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -d "$pkgdir/etc/fansly-recorder"
  echo 'export FANSLY_BROWSER_CHANNEL=chromium' >"$pkgdir/etc/fansly-recorder/env"

  cat >"$pkgdir/usr/bin/fansly-recorder" <<'WRAPPER'
#!/bin/sh
. /etc/fansly-recorder/env
exec python -m fansly_recorder "$@"
WRAPPER
  chmod 755 "$pkgdir/usr/bin/fansly-recorder"
}
